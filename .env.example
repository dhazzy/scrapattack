APP_NAME=Soccer Odds Watcher
APP_ENV=development

DATABASE_URL=postgresql+psycopg://odds_user:odds_password@db:5432/odds
REDIS_URL=redis://redis:6379/0
DB_STARTUP_MAX_RETRIES=20
DB_STARTUP_RETRY_DELAY_SEC=1.5

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PS3838_SOCCER_URL=https://www.ps3838.com/en/sports/soccer
ESTAVE_SOCCER_URL=https://www.e-stave.com/stave
SCRAPER_REQUEST_TIMEOUT_SEC=30
SCRAPER_ENABLE_PLAYWRIGHT=false
SCRAPE_INTERVAL_SEC=300
COMPARE_INTERVAL_SEC=300
ALERT_DISPATCH_INTERVAL_SEC=30

ODDS_DROP_THRESHOLD_PCT=8.0
ODDS_DROP_LOOKBACK_MIN=15
VALUE_EDGE_THRESHOLD_PCT=4.0
ALERT_COOLDOWN_MIN=20

# Use mock odds data for local dev before parser selectors are finalized.
USE_MOCK_SCRAPE_DATA=true
