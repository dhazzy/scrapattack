APP_NAME=Soccer Odds Watcher
APP_ENV=development

DATABASE_URL=postgresql+psycopg://odds_user:odds_password@db:5432/odds
REDIS_URL=redis://redis:6379/0
DB_STARTUP_MAX_RETRIES=20
DB_STARTUP_RETRY_DELAY_SEC=1.5

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PS3838_SOCCER_URL=https://www.ps3838.com/en/sports/soccer
PS3838_REFERER_URL=https://www.ps3838.com/
PS3838_COOKIE_HEADER=
PS3838_PROXY_URL=
PS3838_BROWSER_ONLY=false
PS3838_ENABLE_STEALTH=true
PS3838_RETRY_COUNT=2
PS3838_ZENROWS_API_KEY=
PS3838_SCRAPINGBEE_API_KEY=

VODDS_DASHBOARD_URL=https://vodds.com/member/dashboard
VODDS_USERNAME=
VODDS_PASSWORD=
VODDS_PROXY_URL=
VODDS_HEADLESS=true
VODDS_TIMEOUT_SEC=60

ESTAVE_SOCCER_URL=https://www.e-stave.com/stave
ESTAVE_PAGE_SIZE=25
ESTAVE_MAX_PAGES_PER_QUERY=40
ESTAVE_MAX_EMPTY_PAGES_PER_QUERY=2
ESTAVE_MAX_REPEAT_PAGES_PER_QUERY=2
ESTAVE_MAX_NO_NEW_PAGES_PER_QUERY=3
ESTAVE_EXTRA_B_VALUES=
ESTAVE_G_VALUES=25
SCRAPER_REQUEST_TIMEOUT_SEC=30
SCRAPER_ENABLE_PLAYWRIGHT=true
SCRAPER_PROXY_URL=
SCRAPE_INTERVAL_SEC=300
COMPARE_INTERVAL_SEC=300
ALERT_DISPATCH_INTERVAL_SEC=30

ODDS_DROP_THRESHOLD_PCT=8.0
ODDS_DROP_OPENING_THRESHOLD_PCT=12.0
ODDS_DROP_LOOKBACK_MIN=15
VALUE_EDGE_THRESHOLD_PCT=4.0
ALERT_COOLDOWN_MIN=20
